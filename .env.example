# Copy production values to /etc/ticketsolve/ticketsolve.env on the AWS VPS.
# Never commit the real file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=tikketsolve-systemoneit.uk,www.tikketsolve-systemoneit.uk
CSRF_TRUSTED_ORIGINS=https://tikketsolve-systemoneit.uk,https://www.tikketsolve-systemoneit.uk
TIME_ZONE=Asia/Bangkok
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

EMAIL_SERVICE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Local AWS VPS backup settings
BACKUP_DIR=/var/backups/ticketsolve
BACKUP_RETENTION_DAYS=30
