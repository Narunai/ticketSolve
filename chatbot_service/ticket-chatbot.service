[Unit]
Description=TicketSolve Gemini Chatbot Microservice
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/ticketSolve/chatbot_service
ExecStart=/var/www/ticketSolve/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"

# Security & Sandboxing directives for Linux
ProtectSystem=full
ReadOnlyPaths=/var/www/ticketSolve
ReadWritePaths=/var/www/ticketSolve/chatbot_service

[Install]
WantedBy=multi-user.target
