[Unit]
Description=TicketSolve Gemini Chatbot Microservice
After=network-online.target gunicorn.service
Wants=network-online.target

[Service]
Type=simple
User=ticketsolve-chatbot
Group=ticketsolve-chatbot
WorkingDirectory=/var/www/ticketSolve/chatbot_service
ExecStart=/var/www/ticketSolve/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="CHATBOT_DB_PATH=/var/lib/ticketsolve-chatbot/chatbot.db"
Environment="CHATBOT_SECRET_KEY_FILE=/etc/ticketsolve/chatbot-fernet.key"
Environment="CHATBOT_ALLOWED_ORIGINS=https://tikketsolve-systemoneit.uk,https://www.tikketsolve-systemoneit.uk"
Environment="CHATBOT_ALLOWED_HOSTS=tikketsolve-systemoneit.uk,www.tikketsolve-systemoneit.uk,127.0.0.1,localhost"
Environment="CHATBOT_USER_RATE_PER_MINUTE=20"
UMask=0027

# Security and resource isolation for the internet-facing AI integration.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/www/ticketSolve /etc/ticketsolve/chatbot-fernet.key
ReadWritePaths=/var/lib/ticketsolve-chatbot
MemoryMax=512M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
